#   BUNDLE_GEMFILE=compat/Gemfile RAILS_VERSION="~> 8.1.0" bundle install && BUNDLE_GEMFILE=compat/Gemfile bundle exec rspec
# (Rails 6.1 needs SQLITE_VERSION="~> 1.4"; 8.x needs "~> 2.1".)
